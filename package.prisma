#prisma 4.0
def package "luce-window" {
    str owner = "dymokomi"
    str version = "0.1.4"
    str kind = "package"
    str language = "luce-base"
    str description = "Native desktop windows for Luce on macOS, Windows and Linux (X11): open, size, full screen, cursors, text input, keyboard, pointer and touchpad events, and files dragged in from other applications."
    str readme = "README.md"

    def export "input" {
        str module = "luce_window.input"
    }

    def export "window" {
        str module = "luce_window.window"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }

    def native "macos" {
        str[] libraries = ["objc"]
        str[] frameworks = ["AppKit", "Foundation"]
    }

    def native "windows" {
        str[] libraries = ["user32", "ole32", "shell32"]
    }
}
