import window

## Unsupported targets can import the API and receive its ordinary error without
## linking any native window-system library. No macOS test helpers are imported.
pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    assert(not window.supported())
    var rejected = false
    var surface = window.Window.open() catch failure:
        assert(failure.code == window.unsupported)
        rejected = true
        var empty: window.Window
        recover empty
    surface.destroy()
    assert(rejected)
    print("ok unsupported window target")
    return 0
