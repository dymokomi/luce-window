import luce_window.window

## A host with a window backend but no macOS test helpers (Linux, Windows):
## the API reports support, and opening a window either works (a display is
## there) or is refused as unsupported (none is, as on a headless runner).
pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    assert(window.supported())
    var surface = window.Window.open(window.Options(title = "Supported target contract")) catch failure:
        assert(failure.code == window.unsupported)
        print("ok supported window target")
        return 0
    surface.destroy()
    print("ok supported window target")
    return 0
