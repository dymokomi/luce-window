#==============================================================================================
#
#   input - Window input events, keys and cursors
#
#   DESCRIPTION:
#       Window input uses logical points, with the origin at the content's top left. Physical
#       keys describe positions, not characters. text_input carries committed Unicode scalars
#       supplied by the OS text service when a window enables text input.
#
#==============================================================================================

# mark: Events and keys =======================================================================

## Semantic system cursors, mapped by `window.Window` to the host's DPI-aware resources.
pub enum Cursor as u8:
    arrow = 0
    text = 1
    pointer = 2
    resize_horizontal = 3
    resize_vertical = 4
    grab = 5
    grabbing = 6
    not_allowed = 7
    ## Thin cross hairs, for picking a pixel.
    crosshair = 8
    ## None shown: the application draws its own (a brush's outline, a tool's glyph).
    hidden = 9

## The kind of a window input event; which `Event` fields matter.
pub enum EventKind as u8:
    idle = 0
    close_requested = 1
    resized = 2
    focus_gained = 3
    focus_lost = 4
    key_down = 5
    key_up = 6
    modifiers_changed = 7
    pointer_moved = 8
    pointer_down = 9
    pointer_up = 10
    scroll = 11
    overflow = 12
    text_input = 13
    pointer_entered = 14
    pointer_left = 15
    ## A touchpad pinch: `scroll_y` holds the magnification change (0.1 = 10% larger).
    magnify = 16
    ## Files dragged from another application entered the window at `x`, `y`;
    ## the window's `drop_paths` lists them.
    drag_entered = 17
    ## The drag moved to `x`, `y`.
    drag_moved = 18
    ## The drag left the window, or was cancelled; nothing was dropped.
    drag_left = 19
    ## The files were dropped at `x`, `y`.
    drop = 20

## USB HID keyboard-page usages, independent of the host's virtual key numbers.
## Unknown or unsupported positions produce unknown rather than a guessed key.
pub enum Key as u16:
    unknown = 0
    a = 4
    b = 5
    c = 6
    d = 7
    e = 8
    f = 9
    g = 10
    h = 11
    i = 12
    j = 13
    k = 14
    l = 15
    m = 16
    n = 17
    o = 18
    p = 19
    q = 20
    r = 21
    s = 22
    t = 23
    u = 24
    v = 25
    w = 26
    x = 27
    y = 28
    z = 29
    digit_1 = 30
    digit_2 = 31
    digit_3 = 32
    digit_4 = 33
    digit_5 = 34
    digit_6 = 35
    digit_7 = 36
    digit_8 = 37
    digit_9 = 38
    digit_0 = 39
    enter = 40
    escape = 41
    backspace = 42
    tab = 43
    space = 44
    minus = 45
    equal = 46
    left_bracket = 47
    right_bracket = 48
    backslash = 49
    semicolon = 51
    apostrophe = 52
    grave = 53
    comma = 54
    period = 55
    slash = 56
    caps_lock = 57
    f1 = 58
    f2 = 59
    f3 = 60
    f4 = 61
    f5 = 62
    f6 = 63
    f7 = 64
    f8 = 65
    f9 = 66
    f10 = 67
    f11 = 68
    f12 = 69
    home = 74
    page_up = 75
    delete = 76
    end = 77
    page_down = 78
    right = 79
    left = 80
    down = 81
    up = 82
    left_control = 224
    left_shift = 225
    left_alt = 226
    left_super = 227
    right_control = 228
    right_shift = 229
    right_alt = 230
    right_super = 231

## The modifier keys held during an event.
pub struct Modifiers:
    ## Whether a shift key is held.
    pub var shift: bool
    ## Whether a control key is held.
    pub var control: bool
    ## Whether an alt key is held.
    pub var alt: bool
    ## Whether a super (command/Windows) key is held.
    pub var super: bool
    ## Whether caps lock is on.
    pub var caps_lock: bool

## Whether scroll deltas are in lines or points.
pub enum ScrollUnit as u8:
    lines = 0
    points = 1

## A self-contained value; it retains no native object or borrowed text. Only the
## fields associated with kind are meaningful. Pointer buttons are zero-based:
## 0 left, 1 right, 2 middle, then auxiliary buttons. Scroll deltas retain the OS
## user preference: positive x/y mean scrolling content right/up on macOS.
## On focus_lost or overflow, discard application-held pressed-key/button state.
## pointer_left clears hover, not a captured drag. Pointer coordinates are valid
## on pointer_entered; pointer_left carries no position.
pub struct Event:
    ## The kind of event.
    pub var kind: EventKind
    ## The physical key, for key events.
    pub var key: Key
    ## The modifier keys held.
    pub var modifiers: Modifiers
    ## Whether a key_down is an auto-repeat.
    pub var repeated: bool
    ## The pointer button, zero-based: 0 left, 1 right, 2 middle.
    pub var button: u32
    ## The pointer x in logical points.
    pub var x: f64
    ## The pointer y in logical points.
    pub var y: f64
    ## Content displacement: positive x moves content right, positive y down.
    ## Controls subtract these values from viewport offsets on both axes.
    pub var scroll_x: f64
    ## Vertical scroll displacement (see `scroll_x`).
    pub var scroll_y: f64
    ## The unit of the scroll deltas.
    pub var scroll_unit: ScrollUnit
    ## The Unicode scalar, for text_input events.
    pub var codepoint: u32
    ## Stylus pressure for pointer events, 0..1; zero when the device
    ## reports none, as a mouse does.
    pub var pressure: f64
